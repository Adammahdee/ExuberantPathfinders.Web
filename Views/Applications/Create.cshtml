@model IEnumerable<ExuberantPathfinders.Web.Models.GrantProgram>

@{
    ViewData["Title"] = "Create Application";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h1 class="h4 mb-4">Create New Application</h1>
                        @if (TempData["ApplicationError"] != null)
                        {
                            <div class="alert alert-danger" role="alert">
                                @TempData["ApplicationError"]
                            </div>
                        }

                        @if (!Model.Any())
                        {
                            <div class="alert alert-warning mb-0">
                                There are no active programs available for application at this time.
                            </div>
                        }
                        else
                        {
                            <form asp-action="Create" asp-controller="Applications" method="post">
                                @Html.AntiForgeryToken()

                                <div class="mb-3">
                                    <label for="ProgramId" class="form-label">Program</label>
                                    <select id="ProgramId" name="ProgramId" class="form-select" required>
                                        <option value="">Select a program</option>
                                        @foreach (var program in Model)
                                        {
                                            <option value="@program.Id">@program.Name</option>
                                        }
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label for="Title" class="form-label">Application Title</label>
                                    <input id="Title" name="Title" class="form-control" maxlength="200" required />
                                </div>

                                <div class="mb-3">
                                    <label for="Description" class="form-label">Description</label>
                                    <textarea id="Description" name="Description" class="form-control" rows="5"></textarea>
                                </div>

                                <div class="mb-4">
                                    <label for="RequestedAmount" class="form-label">Requested Amount</label>
                                    <input id="RequestedAmount" name="RequestedAmount" type="number" min="0" step="0.01" class="form-control" required />
                                </div>

                                <div class="border rounded p-3 mb-4 bg-light">
                                    <p class="fw-semibold mb-2">The Pathfinder Agreement</p>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="acceptPathfinderAgreement" name="acceptPathfinderAgreement" value="true" required />
                                        <label class="form-check-label" for="acceptPathfinderAgreement">
                                            I have read and agree to the Community Guidelines. I understand that being an Exuberant Pathfinder means leading with integrity, transparency, and a commitment to strategic community growth. I'm ready to launch.
                                        </label>
                                    </div>
                                    <div class="mt-2 small">
                                        <a asp-controller="Home" asp-action="Terms">View Full Terms of Service</a>
                                        &amp;
                                        <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                                    </div>
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">Save Application</button>
                                    <a href="@Url.Action("Index", "Applications")" class="btn btn-outline-secondary">Cancel</a>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
