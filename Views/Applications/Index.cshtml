@model IEnumerable<ExuberantPathfinders.Web.Models.Application>

@{
    ViewData["Title"] = "My Applications";
}

<section class="py-5 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0 fw-bold text-primary-dark">My Applications</h1>
            <a href="@Url.Action("Create", "Applications")" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold"><i class="fas fa-plus me-2"></i>New Application</a>
        </div>

        @{
            var draftApplication = Model.FirstOrDefault(a => a.Status == ExuberantPathfinders.Web.Models.ApplicationStatus.Draft);
        }

        @if (draftApplication != null)
        {
            <div class="alert alert-warning d-flex justify-content-between align-items-center rounded-4 border-0 shadow-sm mb-4" role="alert">
                <div>
                    <h2 class="h6 mb-1 fw-bold"><i class="fas fa-exclamation-circle me-2"></i>Don't lose the trail!</h2>
                    <p class="mb-0">
                        Your grant application for <strong>@draftApplication.Title</strong> is still waiting.
                        You're only a few steps away from unlocking the resources you need. Jump back in.
                    </p>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0 rounded-4 border-0 shadow-sm text-center p-5">
                <i class="fas fa-folder-open fa-3x mb-3 text-primary-dark opacity-50"></i>
                <p class="lead mb-0">You have not submitted any applications yet.</p>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-card rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-primary-dark">
                        <tr>
                            <th class="border-0 py-3 ps-4">Reference</th>
                            <th class="border-0 py-3">Title</th>
                            <th class="border-0 py-3">Program</th>
                            <th class="border-0 py-3">Amount</th>
                            <th class="border-0 py-3">Status</th>
                            <th class="border-0 py-3">Created</th>
                            <th class="border-0 py-3 pe-4"></th>
                        </tr>
                    </thead>
                        <tbody>
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">@(string.IsNullOrWhiteSpace(app.SubmissionReference) ? "-" : app.SubmissionReference)</td>
                                <td class="fw-500">@app.Title</td>
                                <td class="text-muted">@(app.Program?.Name ?? "N/A")</td>
                                <td class="fw-bold text-dark">@app.RequestedAmount.ToString("C", new System.Globalization.CultureInfo("en-NG"))</td>
                                <td>
                                    @{
                                        var statusClass = app.Status switch
                                        {
                                            ExuberantPathfinders.Web.Models.ApplicationStatus.Approved => "bg-success",
                                            ExuberantPathfinders.Web.Models.ApplicationStatus.Rejected => "bg-danger",
                                            ExuberantPathfinders.Web.Models.ApplicationStatus.Submitted => "bg-primary",
                                            ExuberantPathfinders.Web.Models.ApplicationStatus.UnderReview => "bg-info text-dark",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @statusClass rounded-pill px-3 py-2">@app.Status</span>
                                </td>
                                <td class="text-muted small">@app.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                <td class="text-end pe-4">
                                    @if (app.Status == ExuberantPathfinders.Web.Models.ApplicationStatus.Draft)
                                    {
                                        <button type="button" class="btn btn-success btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#submitModal" data-app-id="@app.Id" data-app-title="@app.Title"><i class="fas fa-paper-plane me-1"></i> Submit</button>
                                        <button type="button" class="btn btn-outline-danger btn-sm ms-1 rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#deleteModal" data-app-id="@app.Id" data-app-title="@app.Title"><i class="fas fa-trash-alt"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            </div>
        }
    </div>
</section>

<!-- Submit Confirmation Modal -->
<div class="modal fade" id="submitModal" tabindex="-1" aria-labelledby="submitModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-primary-dark" id="submitModalLabel">Confirm Submission</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to submit the application for <strong id="modalAppTitle"></strong>? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Submit" asp-controller="Applications" method="post">
                    <input type="hidden" name="id" id="modalAppId" />
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Confirm Submit</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-danger" id="deleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete the application for <strong id="deleteModalAppTitle"></strong>? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" asp-controller="Applications" method="post">
                    <input type="hidden" name="id" id="deleteModalAppId" />
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Confirm Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

    :root {
        --brand-primary: #0E7490;
        --brand-primary-dark: #083344;
        --brand-accent: #F59E0B;
        --brand-accent-hover: #d97706;
        --text-main: #1e293b;
        --text-muted: #64748b;
        --bg-light: #f8fafc;
        --radius-lg: 20px;
        --shadow-soft: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        --shadow-card: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025);
        --shadow-hover: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    body {
        font-family: 'Inter', sans-serif;
        color: var(--text-main);
        background-color: #fff;
    }

    /* Utility Classes */
    .text-primary { color: var(--brand-primary) !important; }
    .text-primary-dark { color: var(--brand-primary-dark) !important; }
    .text-accent { color: var(--brand-accent) !important; }
    .bg-primary { background-color: var(--brand-primary) !important; }
    .bg-accent { background-color: var(--brand-accent) !important; }
    .bg-light { background-color: var(--bg-light) !important; }
    .rounded-4 { border-radius: var(--radius-lg) !important; }
    .shadow-card { box-shadow: var(--shadow-card) !important; }
    .shadow-hover:hover { box-shadow: var(--shadow-hover) !important; transform: translateY(-5px); transition: all 0.3s ease; }

    .btn-primary {
        background-color: var(--brand-primary);
        border-color: var(--brand-primary);
    }
    .btn-primary:hover {
        background-color: var(--brand-primary-dark);
        border-color: var(--brand-primary-dark);
    }
    
    .fw-500 { font-weight: 500; }
</style>

<script>
    var submitModal = document.getElementById('submitModal');
    submitModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var appId = button.getAttribute('data-app-id');
        var appTitle = button.getAttribute('data-app-title');
        var modalTitleInput = submitModal.querySelector('#modalAppTitle');
        var modalIdInput = submitModal.querySelector('#modalAppId');
        
        modalTitleInput.textContent = appTitle;
        modalIdInput.value = appId;
    });

    var deleteModal = document.getElementById('deleteModal');
    deleteModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var appId = button.getAttribute('data-app-id');
        var appTitle = button.getAttribute('data-app-title');
        var modalTitleInput = deleteModal.querySelector('#deleteModalAppTitle');
        var modalIdInput = deleteModal.querySelector('#deleteModalAppId');
        
        modalTitleInput.textContent = appTitle;
        modalIdInput.value = appId;
    });
</script>
