@{
    ViewData["Title"] = "Password reset complete";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-5">
                    <div class="mb-4 text-success">
                        <i class="fas fa-check-circle fa-4x"></i>
                    </div>
                    <h1 class="h3 mb-3">Password reset complete</h1>
                    <p class="text-muted mb-4">
                        Your password has been reset. You can now sign in with the new password.
                    </p>
                    <a asp-action="Login" class="btn btn-primary px-4">Log in</a>
                </div>
            </div>
        </div>
    </div>
</div>
