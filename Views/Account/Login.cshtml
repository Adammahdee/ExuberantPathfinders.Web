@model ExuberantPathfinders.Web.Controllers.LoginViewModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h1 class="h3 mb-3 text-center">ExuberantPathfinders</h1>
                    <h2 class="h4 mb-4 text-center">Sign In</h2>

                    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">
                                Remember me
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Sign in</button>
                    </form>

                    <hr class="my-4" />

                    <p class="text-center">
                        Don't have an account? <a asp-action="Register">Register now</a>
                    </p>

                    <div class="alert alert-info mt-4">
                        <strong>Demo Credentials:</strong>
                        <ul class="mb-0">
                            <li>Admin: <code>admin@exuberant.com</code> / <code>Admin@123456</code></li>
                            <li>Officer: <code>officer@exuberant.com</code> / <code>Officer@123456</code></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
