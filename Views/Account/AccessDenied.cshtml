@{
    ViewData["Title"] = "Access Denied";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 text-center">
                <div class="card border-0 shadow">
                    <div class="card-body p-5">
                        <i class="fas fa-shield-alt fa-4x text-danger mb-4"></i>
                        <h1 class="h3 mb-3">Access Denied</h1>
                        <p class="text-muted mb-4">
                            You do not have permission to access this resource. Please contact an administrator if you believe this is an error.
                        </p>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Return to Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>