@{
    ViewData["Title"] = "Account locked";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-5">
                    <div class="mb-4 text-warning">
                        <i class="fas fa-lock fa-4x"></i>
                    </div>
                    <h1 class="h3 mb-3">Account locked</h1>
                    <p class="text-muted mb-4">
                        This account has been temporarily locked because of multiple failed sign-in attempts.
                    </p>
                    <a asp-action="Login" class="btn btn-primary px-4">Back to login</a>
                </div>
            </div>
        </div>
    </div>
</div>
