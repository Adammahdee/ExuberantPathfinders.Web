@{
    ViewData["Title"] = "Register confirmation";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="mb-4 text-success">
                <i class="fas fa-envelope-open-text fa-4x"></i>
            </div>
            <h1 class="h3 mb-3">Check your email</h1>
            <p class="lead text-muted">
                We have sent a confirmation email to your address. <br />
                Please click the link in that email to activate your account.
            </p>
            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Return Home</a>
            </div>
        </div>
    </div>
</div>