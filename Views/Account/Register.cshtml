@model ExuberantPathfinders.Web.Controllers.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h1 class="h3 mb-3 text-center">ExuberantPathfinders</h1>
                    <h2 class="h4 mb-4 text-center">Create Account</h2>

                    <form asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="FirstName" class="form-label">First Name</label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LastName" class="form-label">Last Name</label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" type="password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="border rounded p-3 mb-4 bg-light">
                            <p class="fw-semibold mb-2">The Pathfinder Agreement</p>
                            <div class="form-check">
                                <input asp-for="AcceptPathfinderAgreement" class="form-check-input" />
                                <label asp-for="AcceptPathfinderAgreement" class="form-check-label">
                                    I have read and agree to the Community Guidelines. I understand that being an Exuberant Pathfinder means leading with integrity, transparency, and a commitment to strategic community growth. I'm ready to launch.
                                </label>
                            </div>
                            <span asp-validation-for="AcceptPathfinderAgreement" class="text-danger"></span>
                            <div class="mt-2 small">
                                <a asp-controller="Home" asp-action="Terms">View Full Terms of Service</a>
                                &amp;
                                <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Create Account</button>
                    </form>

                    <hr class="my-4" />

                    <p class="text-center">
                        Already have an account? <a asp-action="Login">Sign in</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
