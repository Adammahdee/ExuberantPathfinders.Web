@{
    ViewData["Title"] = "Our Services";
}

<section class="py-5 bg-light">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-5 fw-bold mb-3 text-primary-dark">Our Services</h1>
                <p class="lead text-muted">We are dedicated to empowering communities through seven key thematic areas of intervention, designed to foster sustainable growth and development.</p>
            </div>
        </div>

        <!-- Education -->
        <div id="education" class="card border-0 shadow-card rounded-4 mb-5 overflow-hidden">
            <div class="row g-0">
                <div class="col-md-4 bg-white d-flex align-items-center justify-content-center p-5 border-end border-light">
                     <img src="/images/theme-education.svg" alt="Education" class="img-fluid" style="max-height: 120px;">
                </div>
                <div class="col-md-8">
                    <div class="card-body p-5">
                        <h3 class="card-title fw-bold text-primary-dark mb-3">Education</h3>
                        <p class="card-text text-muted mb-4">Quality education is the foundation of sustainable development. We provide skill acquisition programs, scholarships, and educational resources to bridge the gap for underprivileged youth.</p>
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Digital Literacy Training</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Vocational Skills Workshops</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Scholarship Programs</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Healthcare -->
        <div id="healthcare" class="card border-0 shadow-card rounded-4 mb-5 overflow-hidden">
            <div class="row g-0">
                <div class="col-md-4 bg-white d-flex align-items-center justify-content-center p-5 border-end border-light">
                     <img src="/images/theme-healthcare.svg" alt="Healthcare" class="img-fluid" style="max-height: 120px;">
                </div>
                <div class="col-md-8">
                    <div class="card-body p-5">
                        <h3 class="card-title fw-bold text-primary-dark mb-3">Healthcare</h3>
                        <p class="card-text text-muted mb-4">We are committed to improving community health through medical outreach, hygiene sensitization, and partnerships with local health workers.</p>
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Free Medical Checkups</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Maternal Health Support</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Hygiene & Sanitation Awareness</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Climate Change -->
        <div id="climate" class="card border-0 shadow-card rounded-4 mb-5 overflow-hidden">
            <div class="row g-0">
                <div class="col-md-4 bg-white d-flex align-items-center justify-content-center p-5 border-end border-light">
                     <img src="/images/theme-environment.svg" alt="Environment" class="img-fluid" style="max-height: 120px;">
                </div>
                <div class="col-md-8">
                    <div class="card-body p-5">
                        <h3 class="card-title fw-bold text-primary-dark mb-3">Climate Change</h3>
                        <p class="card-text text-muted mb-4">Promoting sustainable practices to protect our environment. We engage youth in tree planting, waste management, and advocacy for climate action.</p>
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Tree Planting Campaigns</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Waste Recycling Initiatives</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Climate Advocacy</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Conflict & Justice -->
        <div id="conflict" class="card border-0 shadow-card rounded-4 mb-5 overflow-hidden">
            <div class="row g-0">
                <div class="col-md-4 bg-white d-flex align-items-center justify-content-center p-5 border-end border-light text-primary">
                     <i class="fas fa-gavel fa-5x"></i>
                </div>
                <div class="col-md-8">
                    <div class="card-body p-5">
                        <h3 class="card-title fw-bold text-primary-dark mb-3">Conflict & Justice</h3>
                        <p class="card-text text-muted mb-4">We work towards peacebuilding and access to justice, ensuring that youth are agents of peace rather than instruments of conflict.</p>
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Peacebuilding Workshops</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Legal Aid Support</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Conflict Resolution Training</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Local Governance -->
        <div id="governance" class="card border-0 shadow-card rounded-4 mb-5 overflow-hidden">
            <div class="row g-0">
                <div class="col-md-4 bg-white d-flex align-items-center justify-content-center p-5 border-end border-light text-primary">
                     <i class="fas fa-city fa-5x"></i>
                </div>
                <div class="col-md-8">
                    <div class="card-body p-5">
                        <h3 class="card-title fw-bold text-primary-dark mb-3">Local Governance</h3>
                        <p class="card-text text-muted mb-4">Encouraging active youth participation in governance and policy-making to ensure inclusive and transparent leadership.</p>
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Civic Education</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Policy Advocacy</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Community Town Halls</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Economic Development -->
        <div id="economic" class="card border-0 shadow-card rounded-4 mb-5 overflow-hidden">
            <div class="row g-0">
                <div class="col-md-4 bg-white d-flex align-items-center justify-content-center p-5 border-end border-light">
                     <img src="/images/theme-economic.svg" alt="Economic" class="img-fluid" style="max-height: 120px;">
                </div>
                <div class="col-md-8">
                    <div class="card-body p-5">
                        <h3 class="card-title fw-bold text-primary-dark mb-3">Economic Development</h3>
                        <p class="card-text text-muted mb-4">Fostering economic self-reliance through entrepreneurship support, business incubation, and access to markets.</p>
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Business Incubation</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Market Access Support</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Financial Literacy</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Strategic Youth Grants -->
        <div id="grants" class="card border-0 shadow-card rounded-4 mb-5 overflow-hidden">
            <div class="row g-0">
                <div class="col-md-4 bg-white d-flex align-items-center justify-content-center p-5 border-end border-light text-primary">
                     <i class="fas fa-hand-holding-usd fa-5x"></i>
                </div>
                <div class="col-md-8">
                    <div class="card-body p-5">
                        <h3 class="card-title fw-bold text-primary-dark mb-3">Strategic Youth Grants</h3>
                        <p class="card-text text-muted mb-4">Providing direct financial support to youth-led initiatives that demonstrate potential for high social impact.</p>
                        <a href="@Url.Action("Index", "Applications")" class="btn btn-primary rounded-pill px-4 fw-bold">Apply for Grant</a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- Follow Us Section -->
<section class="py-5 bg-white">
    <div class="container text-center">
        <h3 class="fw-bold mb-4 text-primary-dark">Follow Us</h3>
        <-radius-lg: 20px;
        --shadow-card: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025);
    }

    body { font-family: 'Inter', sans-serif; color: var(--text-main); }
    .text-primary { color: var(--brand-primary) !important; }
    .text-primary-dark { color: var(--brand-primary-dark) !important; }
    .text-accent { color: var(--brand-accent) !important; }
    .bg-light { background-color: var(--bg-light) !important; }
    .rounded-4 { border-radius: var(--radius-lg) !important; }
    .shadow-card { box-shadow: var(--shadow-card) !important; }
    .btn-primary { background-color: var(--brand-primary); border-color: var(--brand-primary); }
    .btn-primary:hover { background-color: var(--brand-primary-dark); border-color: var(--brand-primary-dark); }

    .social-icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        font-size: 1.25rem;
        color: white;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        text-decoration: none;
    }
    .social-icon-btn svg { transition: transform 0.3s ease; }
    .social-icon-btn:hover svg { transform: scale(1.2); }
    .social-icon-btn:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.15); color: white; }
    .social-icon-btn.facebook { background-color: #1877F2; }
    .social-icon-btn.instagram { background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); }
    .social-icon-btn.twitter { background-color: #000; }
    .social-icon-btn.whatsapp { background-color: #25D366; }
    .social-icon-btn.linkedin { background-color: #0077b5; }
</style>