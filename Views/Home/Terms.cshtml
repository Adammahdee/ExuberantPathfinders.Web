@{
    ViewData["Title"] = "Terms of Service";
}

<section class="py-5 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-md-5">
                        <h1 class="h3 mb-3">Terms of Service</h1>
                        <p class="text-muted">
                            The Exuberant Pathfinders platform is designed to support strategic growth, funding transparency, and safe collaboration.
                            By creating an account or submitting an application, you agree to use this platform responsibly and in line with the Pathfinder mission.
                        </p>

                        <h2 class="h5 mt-4">The Pathfinder Agreement</h2>
                        <p>
                            I have read and agree to the Community Guidelines. I understand that being an Exuberant Pathfinder means
                            leading with integrity, transparency, and a commitment to strategic community growth. I'm ready to launch.
                        </p>

                        <h2 class="h5 mt-4">Links</h2>
                        <ul class="mb-0">
                            <li><a asp-controller="Home" asp-action="CommunityGuidelines">View Community Guidelines</a></li>
                            <li><a asp-controller="Home" asp-action="Privacy">View Privacy Policy</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
