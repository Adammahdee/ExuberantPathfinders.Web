                    <div class="mb-3">
                        <label class="form-label small fw-bold">Areas of Interest</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="checkMentorship">
                            <label class="form-check-label small" for="checkMentorship">Mentorship</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="checkTraining">
                            <label class="form-check-label small" for="checkTraining">Skills Training</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="checkOutreach">
                            <label class="form-check-label small" for="checkOutreach">Community Outreach</label>
