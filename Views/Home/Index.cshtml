<style>
    @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');

    :root {
        --brand-indigo: #4f46e5;
        --brand-purple: #7c3aed;
        --hero-text: #f8f7ff;
        --hero-glass-bg: rgba(255, 255, 255, 0.15);
        --hero-glass-border: rgba(255, 255, 255, 0.28);
    }

    body {
        font-family: "Montserrat", sans-serif;
    }

    /* Navigation Styles */
    .site-nav {
        z-index: 900;
        background: rgba(255, 255, 255, 0.9);
        border-bottom: 1px solid rgba(124, 58, 237, 0.16);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 8px 22px rgba(25, 16, 72, 0.08);
    }

    .navbar-brand {
        font-size: 1.3rem !important;
        color: var(--brand-indigo) !important;
        letter-spacing: 0.02em;
    }

    .nav-link {
        color: #332f56 !important;
        font-weight: 600;
        font-size: 0.95rem;
        margin: 0 8px;
        border-radius: 999px;
        padding: 0.45rem 0.8rem !important;
        transition: color 0.25s ease, background-color 0.25s ease;
    }

    .nav-link:hover {
        color: var(--brand-indigo) !important;
        background: rgba(79, 70, 229, 0.08);
    }

    .nav-link:hover::after {
        content: none;
    }

    .dropdown-menu {
        border: none;
        box-shadow: 0 10px 26px rgba(22, 15, 61, 0.14);
        border-radius: 8px;
    }

    .dropdown-item {
        color: #333;
        transition: all 0.3s ease;
    }

    .dropdown-item:hover {
        background-color: #f0f4ff;
        color: #667eea;
    }

    .fw-500 {
        font-weight: 500;
    }

    .nav-auth-btn {
        border-radius: 999px;
        padding-left: 0.95rem;
        padding-right: 0.95rem;
    }

    /* Promo Styles */
    .promo-shell {
        color: #f6f5ff;
        background: linear-gradient(128deg, #30207a 0%, #4f46e5 52%, #7c3aed 100%);
    }

    .promo-title {
        text-shadow: 0 8px 30px rgba(18, 11, 47, 0.34);
    }

    .promo-copy {
        color: rgba(246, 245, 255, 0.92);
    }

    .promo-copy-muted {
        color: rgba(246, 245, 255, 0.82);
    }

    .promo-cta-solid,
    .promo-cta-outline,
    .promo-card-btn {
        border-radius: 999px;
    }

    .promo-cta-solid {
        color: #2f1e7d;
    }

    .promo-glass-card {
        border: 1px solid rgba(255, 255, 255, 0.26);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        background: rgba(255, 255, 255, 0.9);
        border-radius: 24px;
        color: #2f2a4d;
    }

    .promo-glass-card .card-title {
        color: var(--brand-indigo) !important;
    }

    .promo-glass-card li {
        color: #433c68;
    }

    .promo-glass-card .text-muted {
        color: #6c678f !important;
    }

    /* Hero Styles */
    .hero-shell {
        position: relative;
        overflow: hidden;
        background: linear-gradient(125deg, #2d1b73 0%, var(--brand-indigo) 45%, var(--brand-purple) 100%);
        color: var(--hero-text);
        min-height: min(78vh, 1080px);
    }

    .hero-noise {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 16% 18%, rgba(255, 255, 255, 0.18), transparent 34%),
            radial-gradient(circle at 85% 75%, rgba(255, 255, 255, 0.14), transparent 32%);
        pointer-events: none;
    }

    .hero-container {
        position: relative;
        z-index: 1;
        max-width: 1600px;
    }

    .hero-glass {
        background: var(--hero-glass-bg);
        border: 1px solid var(--hero-glass-border);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: 28px;
        padding: clamp(1.5rem, 2.8vw, 3rem);
        box-shadow: 0 22px 48px rgba(20, 13, 56, 0.28);
    }

    .hero-kicker {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: rgba(255, 255, 255, 0.86);
        font-weight: 600;
    }

    .hero-title {
        font-weight: 800;
        line-height: 1.1;
        font-size: clamp(2rem, 4.1vw, 4.35rem);
        text-wrap: balance;
    }

    .hero-copy {
        font-size: clamp(1rem, 1.35vw, 1.3rem);
        line-height: 1.7;
        max-width: 42ch;
        color: rgba(255, 255, 255, 0.92);
    }

    .hero-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.85rem 1.8rem;
        border-radius: 999px;
        font-weight: 700;
        text-decoration: none;
        transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease, color 0.25s ease;
    }

    .hero-cta-solid {
        background: #ffffff;
        color: #2f1e7d;
        box-shadow: 0 10px 30px rgba(16, 11, 42, 0.28);
    }

    .hero-cta-outline {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.8);
        color: #ffffff;
    }

    .hero-cta:hover {
        transform: translateY(-2px);
    }

    .hero-cta-solid:hover {
        color: #221560;
    }

    .hero-cta-outline:hover {
        background: #ffffff;
        color: #2f1e7d;
    }

    .hero-image-frame {
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 25px 55px rgba(17, 9, 51, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.2);
        min-height: 440px;
        background: rgba(255, 255, 255, 0.08);
    }

    .hero-image {
        width: 100%;
        height: 100%;
        min-height: 440px;
        object-fit: cover;
        display: block;
    }

    /* Section Styles */
    .min-vh-50 {
        min-height: 50vh;
    }

    .stat-box {
        padding: 30px 20px;
        transition: transform 0.3s ease;
    }

    .stat-box:hover {
        transform: translateY(-10px);
    }

    .feature-card {
        transition: all 0.3s ease;
        background: #f8f9fa;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        border-color: #667eea !important;
        box-shadow: 0 10px 25px rgba(102, 126, 234, 0.1);
    }

    .feature-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .topic-badge {
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .topic-badge:hover {
        transform: scale(1.05);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
    }

    .bg-gradient {
        background-size: 200% 200%;
        animation: gradient 15s ease infinite;
    }

    @@keyframes gradient {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    /* Card Styles */
    .card {
        transition: all 0.3s ease;
    }

    .card:hover {
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.15) !important;
        transform: translateY(-2px);
    }

    section h2, section h5 {
        letter-spacing: -0.5px;
    }

    a.text-decoration-none {
        color: #667eea;
        font-weight: 500;
    }

    a.text-decoration-none:hover {
        color: #764ba2;
    }

    .alert-info {
        background-color: #e7f3ff;
        border-color: #667eea;
    }

    .alert-info strong {
        color: #667eea;
    }

    /* Footer Styles */
    .footer-shell {
        border-top: 1px solid #dee2e6;
    }

    .social-icon {
        font-size: 1.75rem;
        margin: 0 1rem;
        color: #6c757d;
        transition: transform 0.2s ease-in-out, color 0.2s ease-in-out;
        display: inline-block;
    }

    .social-icon:hover {
        transform: translateY(-4px);
        color: var(--brand-indigo);
    }

    /* Back to Top Button */
    #btn-back-to-top {
        position: fixed;
        bottom: 30px;
        right: 30px;
        display: none;
        z-index: 1000;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
        transition: opacity 0.3s, transform 0.3s;
        padding: 0;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .hero-shell {
            min-height: auto;
        }

        .hero-glass {
            border-radius: 20px;
            padding: 1.25rem;
        }

        .hero-image-frame,
        .hero-image {
            min-height: 320px;
        }

        .hero-cta {
            width: 100%;
        }

        .nav-link {
            margin: 5px 0;
            padding: 8px 0;
        }

        section {
            padding: 3rem 0 !important;
        }
    }

    /* News Card Styles */
    .news-card {
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: #fff;
        overflow: hidden;
    }

    .news-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
    }

    .news-card .card-img-top {
        height: 220px;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .news-card:hover .card-img-top {
        transform: scale(1.05);
    }

    .read-more-link {
        color: var(--brand-indigo);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .read-more-link:hover {
        color: var(--brand-purple);
    }
</style>

<script>
    // Get the button
    let mybutton = document.getElementById("btn-back-to-top");

    // When the user scrolls down 20px from the top of the document, show the button
    window.addEventListener("scroll", scrollFunction);

    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            mybutton.style.display = "flex";
        } else {
            mybutton.style.display = "none";
        }
    }

    // When the user clicks on the button, scroll to the top of the document
    mybutton.addEventListener("click", backToTop);

    function backToTop() {
        window.scrollTo({top: 0, behavior: 'smooth'});
    }
</script>
