                {
                    <a href="@Url.Action("Index", "Donations")" class="btn btn-primary btn-lg mt-4">
                        <i class="fas fa-donate me-2"></i>DONATE NOW
                    </a>
                }
                else
                {
                    <a href="@Url.Action("Register", "Account")" class="btn btn-primary btn-lg mt-4">
