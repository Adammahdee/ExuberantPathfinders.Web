﻿@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Exuberant Pathfinders - Youth Advancement Initiative";
}

<!-- Navigation Bar -->
<nav class="navbar navbar-expand-lg sticky-top site-nav py-3">
    <div class="container">
        <a class="navbar-brand fw-bold" href="#">
            <i class="fas fa-lightbulb me-2 text-accent"></i><span class="text-primary-dark">EXUBERANT</span> PATHFINDERS
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item">
                    <a class="nav-link fw-500" href="#home">HOME</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-500" href="#promo">PROMO</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-500" href="#about">ABOUT</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-500" href="#testimonials">TESTIMONIALS</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-500" href="#contact">CONTACT</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle fw-500" href="#" id="moreDropdown" role="button" data-bs-toggle="dropdown">
                        MORE
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="moreDropdown">
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="Services">Services</a></li>
                        <li><a class="dropdown-item" href="#procedure">Application Procedure</a></li>
                        <li><a class="dropdown-item" href="#news">News & Stories</a></li>
                        <li><a class="dropdown-item" href="#partners">Our Partners</a></li>
                        <li><a class="dropdown-item" href="#team">Leadership Team</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="Terms">Terms of Service</a></li>
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="CommunityGuidelines">Community Guidelines</a></li>
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="ReportProblem">Report a Problem</a></li>
                    </ul>
                </li>
                @if (!SignInManager.IsSignedIn(User))
                {
                    <li class="nav-item ms-3">
                        <a href="@Url.Action("Login", "Account")" class="btn btn-link text-decoration-none fw-600 me-2 text-primary-dark">Sign In</a>
                        <a href="@Url.Action("Register", "Account")" class="btn btn-primary btn-sm nav-auth-btn px-4">Register</a>
                    </li>
                }
                else
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item ms-3">
                            <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" class="btn btn-outline-primary btn-sm me-2 nav-auth-btn">Admin Dashboard</a>
                        </li>
                    }
                    <li class="nav-item ms-3">
                        <span class="text-muted me-2">Welcome, @User.Identity?.Name</span>
                        <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm nav-auth-btn">Logout</button>
                        </form>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<!-- Hero Section -->
<section id="home" class="hero-shell position-relative overflow-hidden">
    <div class="container hero-container">
        <div class="row align-items-center g-4 g-xl-5">
            <div class="col-lg-6">
                <div class="hero-glass">
                    <span class="badge bg-accent-subtle text-accent-dark mb-3 px-3 py-2 rounded-pill fw-bold">Exuberant Pathfinders Youth Initiatives</span>
                    <h1 class="hero-title mb-4">Empowering Youth through Strategic Grants</h1>
                    <p class="hero-copy mb-4">
                        Building stronger communities through youth-focused grants, practical entrepreneurship support, and strategic partnerships that unlock long-term socioeconomic progress.
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        @if (!SignInManager.IsSignedIn(User))
                        {
                            <a href="@Url.Action("Register", "Account")" class="btn btn-primary btn-lg hero-cta">Apply Now</a>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", "Applications")" class="btn btn-primary btn-lg hero-cta">Apply Now</a>
                        }
                        <a href="#donation-section" class="btn btn-outline-primary btn-lg hero-cta">Donate</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="hero-image-frame">
                    <img
                        src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=1800&q=80"
                        alt="Diverse African youth collaborating in a modern workspace"
                        class="hero-image" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Promo Section -->
<section id="promo" class="py-5 bg-light">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <h2 class="display-5 fw-bold mb-4 text-primary-dark">
                    <i class="fas fa-star me-2 text-accent"></i>Featured Initiative
                </h2>
                <h3 class="mb-3 text-secondary">Youth Skills & Entrepreneurship Program 2026</h3>
                <p class="lead mb-4 text-muted">
                    Transform your future through our comprehensive skills development and entrepreneurship program. Learn in-demand skills, get mentorship, and access startup funding.
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="@Url.Action("Index", "Applications")" class="btn btn-primary btn-lg fw-bold rounded-pill px-4">
                        <i class="fas fa-briefcase me-2"></i>Apply Now
                    </a>
                    <a href="@Url.Action("Services", "Home")" class="btn btn-outline-secondary btn-lg fw-bold rounded-pill px-4">
                        <i class="fas fa-arrow-down me-2"></i>Learn More
                    </a>
                </div>
                <p class="small mt-3 text-muted">
                    <i class="fas fa-calendar me-1"></i> Applications open 24/7 | <i class="fas fa-target me-1"></i> 500+ spots available
                </p>
            </div>
            <div class="col-lg-6">
                <div class="card border-0 shadow-card p-4 rounded-4 bg-white">
                    <div class="text-center mb-4">
                        <div class="icon-circle bg-primary-subtle text-primary mx-auto mb-3">
                            <i class="fas fa-graduation-cap"></i>
                        </div>
                    </div>
                    <h5 class="card-title text-center fw-bold text-primary-dark mb-4">Program Highlights</h5>
                    <ul class="list-unstyled text-secondary">
                        <li class="mb-3"><i class="fas fa-check-circle me-2 text-accent"></i>Skills Training (12 weeks)</li>
                        <li class="mb-3"><i class="fas fa-check-circle me-2 text-accent"></i>Mentorship from Industry Experts</li>
                        <li class="mb-3"><i class="fas fa-check-circle me-2 text-accent"></i>Startup Financing Up to ₦5M</li>
                        <li class="mb-3"><i class="fas fa-check-circle me-2 text-accent"></i>Job Placement Assistance</li>
                        <li class="mb-3"><i class="fas fa-check-circle me-2 text-accent"></i>Lifetime Network Access</li>
                        <li class="mb-3"><i class="fas fa-check-circle me-2 text-accent"></i>Strategic Youth Grants</li>
                    </ul>
                    <a href="#donation-section" class="btn btn-accent w-100 mt-2 rounded-pill fw-bold">Support This Program</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Application Procedure Section -->
<section id="procedure" class="py-5 bg-white">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-6 fw-bold mb-3 text-primary-dark">Application Procedure</h2>
                <p class="lead text-muted">Follow these simple steps to join our program and start your journey towards success.</p>
            </div>
        </div>
        <div class="row g-4 position-relative">
            <!-- Connecting Line (Desktop) -->
            <div class="d-none d-lg-block position-absolute top-50 start-0 w-100 translate-middle-y" style="height: 3px; background-color: #e2e8f0; z-index: 0;"></div>
            
            <!-- Step 1 -->
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 border-0 shadow-hover text-center p-4 position-relative rounded-4 bg-white" style="z-index: 1;">
                    <div class="step-circle bg-primary text-white mx-auto mb-3">1</div>
                    <h5 class="fw-bold text-primary-dark">Register</h5>
                    <p class="text-muted small mb-0">Create an account and complete the online application form.</p>
                </div>
            </div>
            
            <!-- Step 2 -->
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 border-0 shadow-hover text-center p-4 position-relative rounded-4 bg-white" style="z-index: 1;">
                    <div class="step-circle bg-white text-primary border border-2 border-primary mx-auto mb-3">2</div>
                    <h5 class="fw-bold text-primary-dark">Screening</h5>
                    <p class="text-muted small mb-0">Applications are reviewed based on eligibility and potential.</p>
                </div>
            </div>
            
            <!-- Step 3 -->
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 border-0 shadow-hover text-center p-4 position-relative rounded-4 bg-white" style="z-index: 1;">
                    <div class="step-circle bg-white text-primary border border-2 border-primary mx-auto mb-3">3</div>
                    <h5 class="fw-bold text-primary-dark">Training</h5>
                    <p class="text-muted small mb-0">Selected candidates undergo intensive training sessions.</p>
                </div>
            </div>
            
            <!-- Step 4 -->
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 border-0 shadow-hover text-center p-4 position-relative rounded-4 bg-white" style="z-index: 1;">
                    <div class="step-circle bg-accent text-white mx-auto mb-3">4</div>
                    <h5 class="fw-bold text-primary-dark">Funding</h5>
                    <p class="text-muted small mb-0">Successful graduates receive grants and support.</p>
                </div>
            </div>
        </div>
        
        <div class="text-center mt-5">
            @if (!SignInManager.IsSignedIn(User))
            {
                <a href="@Url.Action("Register", "Account")" class="btn btn-primary btn-lg rounded-pill px-5">Start Application</a>
            }
            else
            {
                <a href="@Url.Action("Index", "Applications")" class="btn btn-primary btn-lg rounded-pill px-5">Start Application</a>
            }
        </div>
    </div>
</section>

<!-- News & Stories Section -->
<section id="news" class="py-5 bg-light">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-6 fw-bold mb-3 text-primary-dark">News & Stories</h2>
                <p class="lead text-muted">Stay updated with our latest impact stories, community achievements, and upcoming opportunities.</p>
            </div>
        </div>
        <div class="row g-4 justify-content-center">
            <!-- Card 1 -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 news-card rounded-4 shadow-card">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1531545514256-b1400bc00f31?auto=format&fit=crop&w=800&q=80" class="card-img-top" alt="Youth Workshop" style="height: 220px; object-fit: cover;">
                        <span class="badge bg-primary position-absolute top-0 end-0 m-3">Impact</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="small text-muted mb-2"><i class="far fa-calendar me-2"></i>Oct 15, 2025</div>
                        <h5 class="card-title fw-bold">Empowering 500 Youth in Kano</h5>
                        <p class="card-text text-muted small">Our recent workshop in Kano State successfully trained over 500 young individuals in digital literacy.</p>
                        <a href="#" class="read-more-link stretched-link" data-bs-toggle="modal" data-bs-target="#newsModal1">Read More <i class="fas fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>
            <!-- Card 2 -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 news-card rounded-4 shadow-card">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=800&q=80" class="card-img-top" alt="Community Outreach" style="height: 220px; object-fit: cover;">
                        <span class="badge bg-success position-absolute top-0 end-0 m-3">Health</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="small text-muted mb-2"><i class="far fa-calendar me-2"></i>Sep 28, 2025</div>
                        <h5 class="card-title fw-bold">Community Health Outreach</h5>
                        <p class="card-text text-muted small">Partnering with local health workers to provide free medical checkups and sensitization on hygiene.</p>
                        <a href="#" class="read-more-link stretched-link" data-bs-toggle="modal" data-bs-target="#newsModal2">Read More <i class="fas fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>
            <!-- Card 3 -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 news-card rounded-4 shadow-card">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?auto=format&fit=crop&w=800&q=80" class="card-img-top" alt="Grant Award" style="height: 220px; object-fit: cover;">
                        <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-3">Grants</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="small text-muted mb-2"><i class="far fa-calendar me-2"></i>Aug 10, 2025</div>
                        <h5 class="card-title fw-bold">2025 Grant Winners Announced</h5>
                        <p class="card-text text-muted small">Congratulations to the 50 recipients of our annual business grant. We look forward to seeing your ventures grow.</p>
                        <a href="#" class="read-more-link stretched-link" data-bs-toggle="modal" data-bs-target="#newsModal3">Read More <i class="fas fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>
            <!-- Card 4 -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 news-card rounded-4 shadow-card">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=800&q=80" class="card-img-top" alt="Tech Hub Launch" style="height: 220px; object-fit: cover;">
                        <span class="badge bg-info text-dark position-absolute top-0 end-0 m-3">Innovation</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="small text-muted mb-2"><i class="far fa-calendar me-2"></i>Jul 05, 2025</div>
                        <h5 class="card-title fw-bold">New Tech Hub in Lagos</h5>
                        <p class="card-text text-muted small">Launching a state-of-the-art technology hub to foster innovation and support tech startups.</p>
                        <a href="#" class="read-more-link stretched-link">Read More <i class="fas fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>
            <!-- Card 5 -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 news-card rounded-4 shadow-card">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1517486808906-6ca8b3f04846?auto=format&fit=crop&w=800&q=80" class="card-img-top" alt="Partnership Meeting" style="height: 220px; object-fit: cover;">
                        <span class="badge bg-secondary position-absolute top-0 end-0 m-3">Partnership</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="small text-muted mb-2"><i class="far fa-calendar me-2"></i>Jun 12, 2025</div>
                        <h5 class="card-title fw-bold">Strategic Partnership with UNDP</h5>
                        <p class="card-text text-muted small">Collaborating with UNDP to expand our youth development programs across three new states.</p>
                        <a href="#" class="read-more-link stretched-link">Read More <i class="fas fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center mt-5">
            <a asp-controller="Home" asp-action="News" class="btn btn-outline-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">View All News</a>
        </div>
    </div>
</section>

<!-- About Section -->
<section id="about" class="py-5 bg-white">
    <div class="container">
        <div class="row mb-5 align-items-center">
            <div class="col-lg-6">
                <span class="badge bg-primary-subtle text-primary mb-2">Our Mission</span>
                <h2 class="display-6 fw-bold mb-4 text-primary-dark">Breaking the Cycle of Poverty</h2>
                <p class="lead text-muted">
                    Exuberant Pathfinders project seeks to <strong class="text-primary">“break the cycle of poverty by providing education, technology and economic opportunities to Youths”</strong> as a path to development for the communities they service.
                </p>
                <p class="text-muted">
                    By working together across sectors to achieve a common goal, partners are more effective than they would be separately, a concept known as <strong>collective impact</strong>.
                </p>
            </div>
            <div class="col-lg-6">
                <div class="card bg-light border-0 rounded-4 p-4">
                    <div class="card-body">
                        <h5 class="fw-bold text-primary-dark mb-3">Core Principles</h5>
                        <p class="small text-muted mb-3">Successful community development initiatives and strong teams are built on the foundation of three core principles:</p>
                        <ul class="list-unstyled mb-0">
                            <li class="d-flex mb-3">
                                <i class="fas fa-users text-accent mt-1 me-3"></i>
                                <div>
                                    <strong>Community Engagement</strong>
                                    <div class="small text-muted">Allows youth and stakeholders to participate in identifying unmet needs and finding potential solutions.</div>
                                </div>
                            </li>
                            <li class="d-flex mb-3">
                                <i class="fas fa-user-shield text-accent mt-1 me-3"></i>
                                <div>
                                    <strong>Leadership</strong>
                                    <div class="small text-muted">Leaders serve as champions of an initiative and leverage ongoing support.</div>
                                </div>
                            </li>
                            <li class="d-flex">
                                <i class="fas fa-handshake text-accent mt-1 me-3"></i>
                                <div>
                                    <strong>Collaboration</strong>
                                    <div class="small text-muted">Youth play an integral role in successful projects through cross-sector partnership.</div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-5">
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="row g-0">
                        <div class="col-md-6 bg-primary text-white p-4 p-lg-5 d-flex flex-column justify-content-center">
                            <h4 class="fw-bold mb-3">Educational Methodology</h4>
                            <p class="mb-0">Focusing on the educational component of community development, including the community-wide empowerment that increased educational opportunity creates.</p>
                        </div>
                        <div class="col-md-6 bg-dark text-white p-4 p-lg-5 d-flex flex-column justify-content-center">
                            <h4 class="fw-bold mb-3">Digital Methodology</h4>
                            <p class="mb-0">Addressing the issues and challenges of the Digital divide, making affordable training and access to computers and the Internet, addressing the marginalisation of local communities that cannot connect and participate in the global Online community.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <span class="badge bg-primary-subtle text-primary mb-2">Our Focus</span>
                <h2 class="display-6 fw-bold mb-5 text-primary-dark">Key Areas of Intervention</h2>
                
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="card h-100 border-0 bg-light shadow-sm p-4 rounded-4 flex-row align-items-start gap-4">
                            <div class="text-accent flex-shrink-0">
                                <i class="fas fa-check-circle fa-2x"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-primary-dark">Socioeconomic Development</h5>
                                <p class="text-muted mb-0">Promoting livelihood opportunities through entrepreneurship development and capacity building in rural communities.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100 border-0 bg-light shadow-sm p-4 rounded-4 flex-row align-items-start gap-4">
                            <div class="text-accent flex-shrink-0">
                                <i class="fas fa-check-circle fa-2x"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-primary-dark">Education & Skills</h5>
                                <p class="text-muted mb-0">Building skilled and innovative workforce through research, training and educational opportunities.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100 border-0 bg-light shadow-sm p-4 rounded-4 flex-row align-items-start gap-4">
                            <div class="text-accent flex-shrink-0">
                                <i class="fas fa-check-circle fa-2x"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-primary-dark">Social Protection</h5>
                                <p class="text-muted mb-0">Promoting policies that support youth, education, agriculture and agro-allied skills development.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100 border-0 bg-light shadow-sm p-4 rounded-4 flex-row align-items-start gap-4">
                            <div class="text-accent flex-shrink-0">
                                <i class="fas fa-check-circle fa-2x"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-primary-dark">Leadership Development</h5>
                                <p class="text-muted mb-0">Building leadership capacity and enabling environment for young people across Nigeria.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- What We Do / Services Section -->
<section id="services" class="py-5 bg-light">
    <div class="container">
        <h2 class="display-6 fw-bold mb-4 text-primary-dark">What We Do</h2>
        
        <p class="lead mb-5 text-muted">
            Exuberant Pathfinders focuses on <strong>SEVEN (7) THEMATIC AREAS</strong> to provide service delivery and improve livelihoods of local communities across Nigeria:
        </p>
        
        <div class="row g-3 mb-4">
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 p-4 border-0 shadow-card rounded-4 service-card">
                    <div class="icon-box mb-3">
                        <img src="/images/theme-education.svg" alt="Education" style="width: 50px; height: 50px;">
                    </div>
                    <h5 class="card-title fw-bold text-primary-dark">Education</h5>
                    <p class="card-text text-muted small">Quality education and skill acquisition programs for youth development.</p>
                    <a href="@Url.Action("Services", "Home")#education" class="text-primary fw-bold text-decoration-none mt-3 d-inline-block">Learn More <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 p-4 border-0 shadow-card rounded-4 service-card">
                    <div class="icon-box mb-3">
                        <img src="/images/theme-healthcare.svg" alt="Healthcare" style="width: 50px; height: 50px;">
                    </div>
