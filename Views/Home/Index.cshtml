﻿@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Exuberant Pathfinders - Youth Advancement Initiative";
}

<!-- Navigation Bar -->
<nav class="navbar navbar-expand-lg sticky-top site-nav">
    <div class="container">
        <a class="navbar-brand fw-bold" href="#">
            <i class="fas fa-lightbulb me-2"></i>EXUBERANT PATHFINDERS
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item">
                    <a class="nav-link fw-500" href="#home">HOME</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-500" href="#promo">PROMO</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-500" href="#about">ABOUT</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-500" href="#testimonials">TESTIMONIALS</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-500" href="#contact">CONTACT</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle fw-500" href="#" id="moreDropdown" role="button" data-bs-toggle="dropdown">
                        MORE
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="moreDropdown">
                        <li><a class="dropdown-item" href="#services">Services</a></li>
                        <li><a class="dropdown-item" href="#procedure">Application Procedure</a></li>
                        <li><a class="dropdown-item" href="#news">News & Stories</a></li>
                        <li><a class="dropdown-item" href="#partners">Our Partners</a></li>
                        <li><a class="dropdown-item" href="#team">Leadership Team</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="Terms">Terms of Service</a></li>
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="CommunityGuidelines">Community Guidelines</a></li>
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="ReportProblem">Report a Problem</a></li>
                    </ul>
                </li>
                @if (!SignInManager.IsSignedIn(User))
                {
                    <li class="nav-item ms-3">
                        <a href="@Url.Action("Login", "Account")" class="btn btn-outline-primary btn-sm me-2 nav-auth-btn">Sign In</a>
                        <a href="@Url.Action("Register", "Account")" class="btn btn-primary btn-sm nav-auth-btn">Register</a>
                    </li>
                }
                else
                {
                    <li class="nav-item ms-3">
                        <span class="text-muted me-2">Welcome, @User.Identity?.Name</span>
                        <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm nav-auth-btn">Logout</button>
                        </form>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<!-- Hero Section -->
<section id="home" class="hero-shell py-5">
    <div class="hero-noise"></div>
    <div class="container hero-container">
        <div class="row align-items-center g-4 g-xl-5">
            <div class="col-lg-6">
                <div class="hero-glass">
                    <p class="hero-kicker mb-3">Exuberant Pathfinders Youth Initiatives</p>
                    <h1 class="hero-title mb-4">Empowering Youth through Strategic Grants</h1>
                    <p class="hero-copy mb-4">
                        Building stronger communities through youth-focused grants, practical entrepreneurship support, and strategic partnerships that unlock long-term socioeconomic progress.
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        @if (!SignInManager.IsSignedIn(User))
                        {
                            <a href="@Url.Action("Register", "Account")" class="hero-cta hero-cta-solid">Apply</a>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", "Applications")" class="hero-cta hero-cta-solid">Apply</a>
                        }
                        <a href="#donation-section" class="hero-cta hero-cta-outline">Donate</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="hero-image-frame">
                    <img
                        src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=1800&q=80"
                        alt="Diverse African youth collaborating in a modern workspace"
                        class="hero-image" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Promo Section -->
<section id="promo" class="promo-shell py-5">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <h2 class="display-5 fw-bold mb-4 promo-title">
                    <i class="fas fa-star me-2"></i>Featured Initiative
                </h2>
                <h3 class="mb-3">Youth Skills & Entrepreneurship Program 2026</h3>
                <p class="lead mb-4 promo-copy">
                    Transform your future through our comprehensive skills development and entrepreneurship program. Learn in-demand skills, get mentorship, and access startup funding.
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="@Url.Action("Index", "Applications")" class="btn btn-light btn-lg fw-bold promo-cta-solid">
                        <i class="fas fa-briefcase me-2"></i>Apply Now
                    </a>
                    <a href="#services" class="btn btn-outline-light btn-lg fw-bold promo-cta-outline">
                        <i class="fas fa-arrow-down me-2"></i>Learn More
                    </a>
                </div>
                <p class="small mt-3 promo-copy-muted">
                    <i class="fas fa-calendar me-1"></i> Applications open 24/7 | <i class="fas fa-target me-1"></i> 500+ spots available
                </p>
            </div>
            <div class="col-lg-6">
                <div class="card border-0 shadow-lg p-4 promo-glass-card">
                    <div class="text-center mb-4">
                        <div style="width: 100px; height: 100px; border-radius: 50%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); margin: 0 auto; display: flex; align-items: center; justify-content: center; color: white; font-size: 48px;">
                            <i class="fas fa-graduation-cap"></i>
                        </div>
                    </div>
                    <h5 class="card-title text-center fw-bold" style="color: #667eea;">Program Highlights</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="fas fa-check-circle me-2" style="color: #667eea;"></i>Skills Training (12 weeks)</li>
                        <li class="mb-2"><i class="fas fa-check-circle me-2" style="color: #667eea;"></i>Mentorship from Industry Experts</li>
                        <li class="mb-2"><i class="fas fa-check-circle me-2" style="color: #667eea;"></i>Startup Financing Up to ₦5M</li>
                        <li class="mb-2"><i class="fas fa-check-circle me-2" style="color: #667eea;"></i>Job Placement Assistance</li>
                        <li><i class="fas fa-check-circle me-2" style="color: #667eea;"></i>Lifetime Network Access</li>
                    </ul>
                    <a href="#donation-section" class="btn btn-primary w-100 mt-4 promo-card-btn">Support This Program</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Application Procedure Section -->
<section id="procedure" class="py-5 bg-light">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-6 fw-bold mb-3" style="color: #667eea;">APPLICATION PROCEDURE</h2>
                <p class="lead text-muted">Follow these simple steps to join our program and start your journey towards success.</p>
            </div>
        </div>
        <div class="row g-4 position-relative">
            <!-- Connecting Line (Desktop) -->
            <div class="d-none d-lg-block position-absolute top-50 start-0 w-100 translate-middle-y" style="height: 2px; background-color: #dee2e6; z-index: 0;"></div>
            
            <!-- Step 1 -->
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 border-0 shadow-sm text-center p-4 position-relative" style="z-index: 1;">
                    <div class="rounded-circle bg-white text-primary border border-primary d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold; border-width: 3px !important;">1</div>
                    <h5 class="fw-bold">Register</h5>
                    <p class="text-muted small mb-0">Create an account and complete the online application form.</p>
                </div>
            </div>
            
            <!-- Step 2 -->
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 border-0 shadow-sm text-center p-4 position-relative" style="z-index: 1;">
                    <div class="rounded-circle bg-white text-primary border border-primary d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold; border-width: 3px !important;">2</div>
                    <h5 class="fw-bold">Screening</h5>
                    <p class="text-muted small mb-0">Applications are reviewed based on eligibility and potential.</p>
                </div>
            </div>
            
            <!-- Step 3 -->
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 border-0 shadow-sm text-center p-4 position-relative" style="z-index: 1;">
                    <div class="rounded-circle bg-white text-primary border border-primary d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold; border-width: 3px !important;">3</div>
                    <h5 class="fw-bold">Training</h5>
                    <p class="text-muted small mb-0">Selected candidates undergo intensive training sessions.</p>
                </div>
            </div>
            
            <!-- Step 4 -->
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 border-0 shadow-sm text-center p-4 position-relative" style="z-index: 1;">
                    <div class="rounded-circle bg-primary text-white border border-primary d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold; border-width: 3px !important;">4</div>
                    <h5 class="fw-bold">Funding</h5>
                    <p class="text-muted small mb-0">Successful graduates receive grants and support.</p>
                </div>
            </div>
        </div>
        
        <div class="text-center mt-5">
            @if (!SignInManager.IsSignedIn(User))
            {
                <a href="@Url.Action("Register", "Account")" class="btn btn-primary btn-lg rounded-pill px-5">Start Application</a>
            }
            else
            {
                <a href="@Url.Action("Index", "Applications")" class="btn btn-primary btn-lg rounded-pill px-5">Start Application</a>
            }
        </div>
    </div>
</section>

<!-- News & Stories Section -->
<section id="news" class="py-5">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-6 fw-bold mb-3" style="color: #667eea;">News & Stories</h2>
                <p class="lead text-muted">Stay updated with our latest impact stories, community achievements, and upcoming opportunities.</p>
            </div>
        </div>
        <div class="row g-4 justify-content-center">
            <!-- Card 1 -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 news-card">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1531545514256-b1400bc00f31?auto=format&fit=crop&w=800&q=80" class="card-img-top" alt="Youth Workshop" style="height: 220px; object-fit: cover;">
