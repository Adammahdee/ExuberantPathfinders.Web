@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Exuberant Pathfinders - Youth Advancement Initiative";
}

<!-- Navigation Bar -->
<nav class="navbar navbar-expand-lg navbar-white bg-white sticky-top border-bottom" style="z-index: 900;">
    <div class="container">
        <a class="navbar-brand fw-bold" href="#" style="color: #667eea; font-size: 1.3rem;">
            <i class="fas fa-lightbulb me-2"></i>EXUBERANT PATHFINDERS
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item">
                    <a class="nav-link fw-500" href="#home">HOME</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-500" href="#promo">PROMO</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-500" href="#about">ABOUT</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-500" href="#testimonials">TESTIMONIALS</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-500" href="#contact">CONTACT</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle fw-500" href="#" id="moreDropdown" role="button" data-bs-toggle="dropdown">
                        MORE
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="moreDropdown">
                        <li><a class="dropdown-item" href="#services">Services</a></li>
                        <li><a class="dropdown-item" href="#partners">Our Partners</a></li>
                        <li><a class="dropdown-item" href="#team">Leadership Team</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#">Terms & Conditions</a></li>
                        <li><a class="dropdown-item" href="#">Privacy Policy</a></li>
                    </ul>
                </li>
                @if (!SignInManager.IsSignedIn(User))
                {
                    <li class="nav-item ms-3">
                        <a href="@Url.Action("Login", "Account")" class="btn btn-outline-primary btn-sm me-2">Sign In</a>
                        <a href="@Url.Action("Register", "Account")" class="btn btn-primary btn-sm">Register</a>
                    </li>
                }
                else
                {
                    <li class="nav-item ms-3">
                        <span class="text-muted me-2">Welcome, @User.Identity?.Name</span>
                        <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">Logout</button>
                        </form>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<!-- Hero Section -->
<section id="home" class="py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <h2 class="display-4 fw-bold mb-4" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.3);">
                    Empowering Youth Through Strategic Grants & Community Support
                </h2>
                <p class="lead mb-4" style="font-size: 1.125rem;">
                    We focus on improving livelihoods and promoting socioeconomic development of local communities across Nigeria through education, entrepreneurship, and strategic partnerships.
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    @if (!SignInManager.IsSignedIn(User))
                    {
                        <a href="@Url.Action("Register", "Account")" class="btn btn-light btn-lg fw-bold">
                            <i class="fas fa-user-plus me-2"></i>Get Started
                        </a>
                        <a href="#donation-section" class="btn btn-outline-light btn-lg fw-bold">
                            <i class="fas fa-heart me-2"></i>Support Us
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "Applications")" class="btn btn-light btn-lg fw-bold">
                            <i class="fas fa-file-alt me-2"></i>My Applications
                        </a>
                        <a href="@Url.Action("Index", "Donations")" class="btn btn-outline-light btn-lg fw-bold">
                            <i class="fas fa-heart me-2"></i>Donate
                        </a>
                    }
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div style="background: rgba(255,255,255,0.1); padding: 30px; border-radius: 10px; backdrop-filter: blur(10px);">
                    <img src="/images/hero-grants.svg" alt="Grants & Donations" style="width: 100%; max-width: 400px; height: auto; filter: drop-shadow(0 10px 25px rgba(0,0,0,0.3));">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Promo Section -->
<section id="promo" class="py-5" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <h2 class="display-5 fw-bold mb-4">
                    <i class="fas fa-star me-2"></i>Featured Initiative
                </h2>
                <h3 class="mb-3">Youth Skills & Entrepreneurship Program 2026</h3>
                <p class="lead mb-4">
                    Transform your future through our comprehensive skills development and entrepreneurship program. Learn in-demand skills, get mentorship, and access startup funding.
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="@Url.Action("Index", "Applications")" class="btn btn-light btn-lg fw-bold">
                        <i class="fas fa-briefcase me-2"></i>Apply Now
                    </a>
                    <a href="#services" class="btn btn-outline-light btn-lg fw-bold">
                        <i class="fas fa-arrow-down me-2"></i>Learn More
                    </a>
                </div>
                <p class="small text-white-50 mt-3">
                    <i class="fas fa-calendar me-1"></i> Applications open 24/7 | <i class="fas fa-target me-1"></i> 500+ spots available
                </p>
            </div>
            <div class="col-lg-6">
                <div class="card border-0 shadow-lg p-4" style="background: rgba(255,255,255,0.95);">
                    <div class="text-center mb-4">
                        <div style="width: 100px; height: 100px; border-radius: 50%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); margin: 0 auto; display: flex; align-items: center; justify-content: center; color: white; font-size: 48px;">
                            <i class="fas fa-graduation-cap"></i>
                        </div>
                    </div>
                    <h5 class="card-title text-center fw-bold" style="color: #667eea;">Program Highlights</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="fas fa-check-circle me-2" style="color: #667eea;"></i>Skills Training (12 weeks)</li>
                        <li class="mb-2"><i class="fas fa-check-circle me-2" style="color: #667eea;"></i>Mentorship from Industry Experts</li>
                        <li class="mb-2"><i class="fas fa-check-circle me-2" style="color: #667eea;"></i>Startup Financing Up to ₦5M</li>
                        <li class="mb-2"><i class="fas fa-check-circle me-2" style="color: #667eea;"></i>Job Placement Assistance</li>
                        <li><i class="fas fa-check-circle me-2" style="color: #667eea;"></i>Lifetime Network Access</li>
                    </ul>
                    <a href="#donation-section" class="btn btn-primary w-100 mt-4">Support This Program</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Section -->
