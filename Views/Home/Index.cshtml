                    <div class="mb-3">
                        <label for="volEmail" class="form-label small fw-bold">Email Address</label>
                        <input type="email" class="form-control" id="volEmail" placeholder="name@example.com" required>
                    </div>
                    <div class="mb-3">
                        <label for="volPhone" class="form-label small fw-bold">Phone Number</label>
                        <input type="tel" class="form-control" id="volPhone" placeholder="+234..." required>
