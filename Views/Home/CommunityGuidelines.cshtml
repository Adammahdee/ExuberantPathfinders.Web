@{
    ViewData["Title"] = "Community Guidelines";
}

<section class="py-5 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-md-5">
                        <h1 class="h3 mb-3">Community Guidelines</h1>
                        <p>These standards keep the Pathfinder mission clear, empowering, and safe for everyone.</p>

                        <h2 class="h5 mt-4">1. Lead with Vision</h2>
                        <p class="mb-1"><strong>Innovate Boldly:</strong> Prioritize ideas that solve community challenges long term.</p>
                        <p><strong>Share Knowledge:</strong> Support peers with practical insights and mentorship.</p>

                        <h2 class="h5 mt-4">2. Strategic Integrity</h2>
                        <p class="mb-1"><strong>Transparency First:</strong> Share honest progress and funding updates.</p>
                        <p><strong>Accountability:</strong> Own progress and learn openly from setbacks.</p>

                        <h2 class="h5 mt-4">3. Collaborative Spirit</h2>
                        <p class="mb-1"><strong>Build Partnerships:</strong> Strengthen impact through collaboration.</p>
                        <p><strong>Respect the Network:</strong> Treat mentors, partners, and peers with professional courtesy.</p>

                        <h2 class="h5 mt-4">4. Safe and Inclusive Spaces</h2>
                        <p class="mb-1"><strong>Zero Tolerance:</strong> Harassment, discrimination, and exploitation are not allowed.</p>
                        <p><strong>Empower Others:</strong> Lift others so Exuberant energy is accessible to all.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
