@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "News & Stories";
}

<section class="py-5 bg-light">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-5 fw-bold mb-3 text-primary-dark">News & Stories</h1>
                <p class="lead text-muted">Stay updated with our latest impact stories, community achievements, and upcoming opportunities.</p>
            </div>
        </div>

        <!-- News Grid -->
        <div class="row g-4">
            <!-- Card 1 -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 news-card rounded-4 shadow-card">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1531545514256-b1400bc00f31?auto=format&fit=crop&w=800&q=80" class="card-img-top" alt="Youth Workshop" style="height: 220px; object-fit: cover;">
                        <span class="badge bg-primary position-absolute top-0 end-0 m-3">Impact</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="small text-muted mb-2"><i class="far fa-calendar me-2"></i>Oct 15, 2025</div>
                        <h5 class="card-title fw-bold text-primary-dark">Empowering 500 Youth in Kano</h5>
                        <p class="card-text text-muted small">Our recent workshop in Kano State successfully trained over 500 young individuals in digital literacy.</p>
                        <a href="#" class="read-more-link stretched-link">Read More <i class="fas fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>
            <!-- Card 2 -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 news-card rounded-4 shadow-card">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=800&q=80" class="card-img-top" alt="Community Outreach" style="height: 220px; object-fit: cover;">
                        <span class="badge bg-success position-absolute top-0 end-0 m-3">Health</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="small text-muted mb-2"><i class="far fa-calendar me-2"></i>Sep 28, 2025</div>
                        <h5 class="card-title fw-bold text-primary-dark">Community Health Outreach</h5>
                        <p class="card-text text-muted small">Partnering with local health workers to provide free medical checkups and sensitization on hygiene.</p>
                        <a href="#" class="read-more-link stretched-link">Read More <i class="fas fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>
            <!-- Card 3 -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 news-card rounded-4 shadow-card">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?auto=format&fit=crop&w=800&q=80" class="card-img-top" alt="Grant Award" style="height: 220px; object-fit: cover;">
                        <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-3">Grants</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="small text-muted mb-2"><i class="far fa-calendar me-2"></i>Aug 10, 2025</div>
                        <h5 class="card-title fw-bold text-primary-dark">2025 Grant Winners Announced</h5>
                        <p class="card-text text-muted small">Congratulations to the 50 recipients of our annual business grant. We look forward to seeing your ventures grow.</p>
                        <a href="#" class="read-more-link stretched-link">Read More <i class="fas fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>
            <!-- Card 4 -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 news-card rounded-4 shadow-card">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=800&q=80" class="card-img-top" alt="Tech Hub Launch" style="height: 220px; object-fit: cover;">
                        <span class="badge bg-info text-dark position-absolute top-0 end-0 m-3">Innovation</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="small text-muted mb-2"><i class="far fa-calendar me-2"></i>Jul 05, 2025</div>
                        <h5 class="card-title fw-bold text-primary-dark">New Tech Hub in Lagos</h5>
                        <p class="card-text text-muted small">Launching a state-of-the-art technology hub to foster innovation and support tech startups.</p>
                        <a href="#" class="read-more-link stretched-link">Read More <i class="fas fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>
            <!-- Card 5 -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 news-card rounded-4 shadow-card">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1517486808906-6ca8b3f04846?auto=format&fit=crop&w=800&q=80" class="card-img-top" alt="Partnership Meeting" style="height: 220px; object-fit: cover;">
                        <span class="badge bg-secondary position-absolute top-0 end-0 m-3">Partnership</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="small text-muted mb-2"><i class="far fa-calendar me-2"></i>Jun 12, 2025</div>
                        <h5 class="card-title fw-bold text-primary-dark">Strategic Partnership with UNDP</h5>
                        <p class="card-text text-muted small">Collaborating with UNDP to expand our youth development programs across three new states.</p>
                        <a href="#" class="read-more-link stretched-link">Read More <i class="fas fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <div class="mt-5">
            <nav aria-label="News pagination">
                <ul class="pagination justify-content-center">
                    <li class="page-item disabled">
                        <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Previous</a>
                    </li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item">
                        <a class="page-link" href="#">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</section>

<!-- Application Procedure Section -->
<section id="procedure" class="py-5 bg-white">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-6 fw-bold mb-3 text-primary-dark">Application Procedure</h2>
                <p class="lead text-muted">Follow these simple steps to join our program and start your journey towards success.</p>
            </div>
        </div>
        
        <div id="procedureCarousel" class="carousel carousel-dark slide" data-bs-ride="carousel" data-bs-interval="3000">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#procedureCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Step 1"></button>
                <button type="button" data-bs-target="#procedureCarousel" data-bs-slide-to="1" aria-label="Step 2"></button>
                <button type="button" data-bs-target="#procedureCarousel" data-bs-slide-to="2" aria-label="Step 3"></button>
                <button type="button" data-bs-target="#procedureCarousel" data-bs-slide-to="3" aria-label="Step 4"></button>
            </div>
            <div class="carousel-inner">
                <!-- Step 1 -->
                <div class="carousel-item active">
                    <div class="card border-0 shadow-card text-center p-5 mx-auto rounded-4" style="max-width: 500px;">
                        <div class="step-circle bg-primary text-white mx-auto mb-3">1</div>
                        <h3 class="fw-bold mb-3 text-primary-dark">Register</h3>
                        <p class="text-muted lead mb-0">Create an account and complete the online application form.</p>
                    </div>
                </div>
                <!-- Step 2 -->
                <div class="carousel-item">
                    <div class="card border-0 shadow-card text-center p-5 mx-auto rounded-4" style="max-width: 500px;">
                        <div class="step-circle bg-white text-primary border border-2 border-primary mx-auto mb-3">2</div>
                        <h3 class="fw-bold mb-3 text-primary-dark">Screening</h3>
                        <p class="text-muted lead mb-0">Applications are reviewed based on eligibility and potential.</p>
                    </div>
                </div>
                <!-- Step 3 -->
                <div class="carousel-item">
                    <div class="card border-0 shadow-card text-center p-5 mx-auto rounded-4" style="max-width: 500px;">
                        <div class="step-circle bg-white text-primary border border-2 border-primary mx-auto mb-3">3</div>
                        <h3 class="fw-bold mb-3 text-primary-dark">Training</h3>
                        <p class="text-muted lead mb-0">Selected candidates undergo intensive training sessions.</p>
                    </div>
                </div>
                <!-- Step 4 -->
                <div class="carousel-item">
                    <div class="card border-0 shadow-card text-center p-5 mx-auto rounded-4" style="max-width: 500px;">
                        <div class="step-circle bg-accent text-white mx-auto mb-3">4</div>
                        <h3 class="fw-bold mb-3 text-primary-dark">Funding</h3>
                        <p class="text-muted lead mb-0">Successful graduates receive grants and support.</p>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#procedureCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#procedureCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
        
        <div class="text-center mt-5">
            @if (!SignInManager.IsSignedIn(User))
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg rounded-pill px-5">Start Application</a>
            }
            else
            {
                <a asp-controller="Applications" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5">Start Application</a>
            }
        </div>
    </div>
</section>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

    :root {
        --brand-primary: #0E7490;
        --brand-primary-dark: #083344;
        --brand-accent: #F59E0B;
        --brand-accent-hover: #d97706;
        --text-main: #1e293b;
        --text-muted: #64748b;
        --bg-light: #f8fafc;
        --radius-lg: 20px;
        --shadow-soft: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        --shadow-card: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025);
        --shadow-hover: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    body {
        font-family: 'Inter', sans-serif;
        color: var(--text-main);
        background-color: #fff;
    }

    /* Utility Classes */
    .text-primary { color: var(--brand-primary) !important; }
    .text-primary-dark { color: var(--brand-primary-dark) !important; }
    .text-accent { color: var(--brand-accent) !important; }
    .bg-primary { background-color: var(--brand-primary) !important; }
    .bg-accent { background-color: var(--brand-accent) !important; }
    .bg-light { background-color: var(--bg-light) !important; }
    .rounded-4 { border-radius: var(--radius-lg) !important; }
    .shadow-card { box-shadow: var(--shadow-card) !important; }
    .shadow-hover:hover { box-shadow: var(--shadow-hover) !important; transform: translateY(-5px); transition: all 0.3s ease; }

    .btn-primary {
        background-color: var(--brand-primary);
        border-color: var(--brand-primary);
    }
    .btn-primary:hover {
        background-color: var(--brand-primary-dark);
        border-color: var(--brand-primary-dark);
    }

    .step-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: bold;
    }

    .news-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        overflow: hidden;
    }

    .news-card:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-hover);
    }

    .news-card .card-img-top {
        height: 220px;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .news-card:hover .card-img-top {
        transform: scale(1.05);
    }

    .read-more-link {
        color: var(--brand-primary);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .read-more-link:hover {
        color: var(--brand-primary-dark);
    }
</style>