@model IEnumerable<ExuberantPathfinders.Web.Models.Campaign>

@{
    ViewData["Title"] = "Donation Campaigns";
}

<section class="py-5 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">Active Donation Campaigns</h1>
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-sm">Back to Home</a>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                There are no active campaigns right now. Please check back later.
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var campaign in Model)
                {
                    var progress = campaign.TargetAmount > 0
                        ? Math.Min(100, (int)Math.Round((campaign.AmountRaised / campaign.TargetAmount) * 100))
                        : 0;

                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@campaign.Name</h5>
                                <p class="card-text text-muted flex-grow-1">@campaign.Description</p>

                                <p class="mb-1 small">
                                    <strong>Program:</strong> @(campaign.Program?.Name ?? "N/A")
                                </p>
                                <p class="mb-1 small">
                                    <strong>Raised:</strong> @campaign.AmountRaised.ToString("C")
                                </p>
                                <p class="mb-2 small">
                                    <strong>Target:</strong> @campaign.TargetAmount.ToString("C")
                                </p>

                                <div class="progress mb-3" style="height: 8px;">
                                    <div class="progress-bar" role="progressbar" style="width: @progress%;" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>

                                <a href="@Url.Action("Details", "Donations", new { id = campaign.Id })" class="btn btn-primary btn-sm">
                                    View Campaign
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
