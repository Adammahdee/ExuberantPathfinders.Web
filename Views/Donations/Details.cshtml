@model ExuberantPathfinders.Web.Models.Campaign

@{
    ViewData["Title"] = "Campaign Details";
    var progress = Model.TargetAmount > 0
        ? Math.Min(100, (int)Math.Round((Model.AmountRaised / Model.TargetAmount) * 100))
        : 0;
}

<section class="py-5">
    <div class="container">
        <div class="mb-3">
            <a href="@Url.Action("Index", "Donations")" class="btn btn-outline-secondary btn-sm">Back to Campaigns</a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h3">@Model.Name</h1>
                <p class="text-muted">@Model.Description</p>

                <p class="mb-1"><strong>Program:</strong> @(Model.Program?.Name ?? "N/A")</p>
                <p class="mb-1"><strong>Raised:</strong> @Model.AmountRaised.ToString("C")</p>
                <p class="mb-3"><strong>Target:</strong> @Model.TargetAmount.ToString("C")</p>

                <div class="progress mb-4" style="height: 10px;">
                    <div class="progress-bar" role="progressbar" style="width: @progress%;" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <form asp-action="CreateDonation" asp-controller="Donations" method="post" class="row g-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="campaignId" value="@Model.Id" />
                    <div class="col-sm-8">
                        <label for="amount" class="form-label">Donation Amount</label>
                        <input id="amount" name="amount" type="number" min="1" step="0.01" class="form-control" required />
                    </div>
                    <div class="col-sm-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Donate</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
