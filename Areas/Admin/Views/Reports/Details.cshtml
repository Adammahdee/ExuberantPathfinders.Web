@model ExuberantPathfinders.Web.Models.Report
@{
    ViewData["Title"] = "Report Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Report #@Model.Id</h1>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Issue Type</dt>
            <dd class="col-sm-9">@Model.IssueType</dd>

            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsResolved)
                {
                    <span class="badge bg-success">Resolved</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Pending</span>
                }
            </dd>

            <dt class="col-sm-3">Message</dt>
            <dd class="col-sm-9" style="white-space: pre-wrap;">@Model.Message</dd>

            @if (Model.IsResolved)
            {
                <dt class="col-sm-3">Resolved At</dt>
                <dd class="col-sm-9">@Model.ResolvedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>

                <dt class="col-sm-3">Resolution Notes</dt>
                <dd class="col-sm-9" style="white-space: pre-wrap;">@Model.ResolutionNotes</dd>
            }
        </dl>
    </div>
</div>

@if (!Model.IsResolved)
{
    <div class="card">
        <div class="card-header">Resolve Report</div>
        <div class="card-body">
            <form asp-action="Resolve" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label" for="emailSubject">Email Subject</label>
                    <input id="emailSubject" name="emailSubject" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="resolutionNotes">Resolution Notes / Email Body</label>
                    <textarea id="resolutionNotes" name="resolutionNotes" rows="5" class="form-control" required></textarea>
                </div>
                <button type="submit" class="btn btn-success">Resolve and Send Email</button>
            </form>
        </div>
    </div>
}
else
{
    <form asp-action="Reopen" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-warning">Reopen Report</button>
    </form>
}
