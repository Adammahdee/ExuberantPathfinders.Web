@model IEnumerable<ExuberantPathfinders.Web.Areas.Admin.ViewModels.RoleViewModel>
@{ ViewData["Title"] = "Roles"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Roles</h1>
    <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus"></i> Create Role</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Role Name</th>
                    <th>Users Count</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td>@role.Name</td>
                        <td>@role.UserCount</td>
                        <td class="text-end">
                            <a asp-action="ManagePermissions" asp-route-id="@role.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="fas fa-key"></i> Permissions
                            </a>
                            @if (role.Name != "Admin" && role.Name != "ProgramOfficer" && role.Name != "User")
                            {
                                <form asp-action="Delete" asp-route-id="@role.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this role?');">
                                    <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i> Delete</button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-secondary" disabled title="System Role"><i class="fas fa-lock"></i></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>