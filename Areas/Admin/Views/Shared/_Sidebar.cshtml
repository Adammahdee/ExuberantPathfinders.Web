<div class="d-flex flex-column flex-shrink-0 p-3 text-white bg-dark h-100">
    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
        <i class="bi bi-compass-fill me-2"></i>
        <span class="fs-4">Exuberant Pathfinders</span>
    </a>
    <hr>
    <ul class="nav nav-pills flex-column mb-auto">
        <li class="nav-item">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link text-white" highlight-active>
                <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
        </li>
        <li>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Applications" class="nav-link text-white" highlight-active>
                <i class="bi bi-file-earmark-person me-2"></i> Applicants
            </a>
        </li>
        <li>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Grants" class="nav-link text-white" highlight-active>
                <i class="bi bi-award me-2"></i> Grants
            </a>
        </li>
        <li>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Funds" class="nav-link text-white" highlight-active>
                <i class="bi bi-cash-stack me-2"></i> Funds
            </a>
        </li>
        <li>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Users" class="nav-link text-white" highlight-active>
                <i class="bi bi-people me-2"></i> User Management
            </a>
        </li>
        <li>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Reports" class="nav-link text-white" highlight-active>
                <i class="bi bi-graph-up me-2"></i> Reports
            </a>
        </li>
        <li>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Logs" class="nav-link text-white" highlight-active>
                <i class="bi bi-journal-text me-2"></i> Audit Logs
            </a>
        </li>
    </ul>
    <hr>
    <div class="dropdown">
        <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person-circle me-2 fs-4"></i>
            <strong>@(User.Identity?.Name ?? "Admin")</strong>
        </a>
        <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="dropdownUser1">
            <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">Back to Site</a></li>
            <li><a class="dropdown-item" href="#">Profile</a></li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <form class="d-inline" asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item">Sign out</button>
                </form>
            </li>
        </ul>
    </div>
</div>