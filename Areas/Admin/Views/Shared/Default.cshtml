@model dynamic

<div class="row">
    <div class="col-md-6">
        <div class="card bg-warning text-dark mb-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-0 fw-bold">@Model.Pending</h2>
                    <div class="small fw-bold text-uppercase opacity-75">Pending Reports</div>
                </div>
                <i class="fas fa-exclamation-triangle fa-2x opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card bg-success text-white mb-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-0 fw-bold">@Model.Resolved</h2>
                    <div class="small fw-bold text-uppercase opacity-75">Resolved Reports</div>
                </div>
                <i class="fas fa-check-circle fa-2x opacity-50"></i>
            </div>
        </div>
    </div>
</div>