@model ExuberantPathfinders.Web.Areas.Admin.ViewModels.GrantManagementViewModel

@{
    ViewData["Title"] = "Grants";
}

<div class="container-fluid mt-3">
    @if (!string.IsNullOrWhiteSpace(Model.FormSuccess))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.FormSuccess
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.FormError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.FormError
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-0">
            <h5 class="mb-0">Create Grant Program</h5>
        </div>
        <div class="card-body">
            <form asp-action="CreateGrant" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <div class="col-md-4">
                    <label class="form-label">Name</label>
                    <input type="text" name="name" class="form-control" required minlength="3" maxlength="120" />
                    <small class="text-muted">3-120 characters.</small>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Thematic Area</label>
                    <select name="thematicAreaId" class="form-select" required>
                        <option value="">Select area</option>
                        @foreach (var area in Model.ThematicAreas)
                        {
                            <option value="@area.Id">@area.Name (@area.Code)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Program Officer</label>
                    <select name="programOfficerId" class="form-select" required>
                        <option value="">Select officer</option>
                        @foreach (var officer in Model.ProgramOfficers)
                        {
                            <option value="@officer.Id">@officer.FirstName @officer.LastName (@officer.Email)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Budget</label>
                    <input type="number" min="0.01" step="0.01" name="budget" class="form-control" required />
                    <small class="text-muted">0.01 to 100,000,000,000.</small>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Start Date</label>
                    <input type="date" name="startDate" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">End Date</label>
                    <input type="date" name="endDate" class="form-control" />
                    <small class="text-muted">Optional, cannot be earlier than start date.</small>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Description</label>
                    <input type="text" name="description" class="form-control" maxlength="500" />
                    <small class="text-muted">Max 500 characters.</small>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-success">Create Grant</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0">
            <h5 class="mb-0">Existing Grants</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Thematic Area</th>
                            <th>Officer</th>
                            <th>Budget</th>
                            <th>Apps</th>
                            <th>Funds</th>
                            <th>Status</th>
                            <th style="min-width: 260px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var grant in Model.Grants)
                        {
                            <tr>
                                <td>@grant.Name</td>
                                <td>@(grant.ThematicArea?.Name ?? "N/A")</td>
                                <td>@(grant.ProgramOfficer?.Email ?? "N/A")</td>
                                <td>&#8358;@grant.Budget.ToString("N2")</td>
                                <td>@grant.Applications.Count</td>
                                <td>@grant.Campaigns.Count</td>
                                <td>
                                    <span class="badge @(grant.IsActive ? "bg-success" : "bg-danger")">@(grant.IsActive ? "Active" : "Inactive")</span>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        <form asp-action="ToggleGrantStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@grant.Id" />
                                            <button type="submit" class="btn btn-sm @(grant.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                                @(grant.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editGrantModal-@grant.Id">
                                            Edit
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteGrantModal-@grant.Id">
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@foreach (var grant in Model.Grants)
{
    <div class="modal fade" id="editGrantModal-@grant.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form asp-action="EditGrant" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Grant: @grant.Name</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="id" value="@grant.Id" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Name</label>
                                <input type="text" name="name" value="@grant.Name" class="form-control" required minlength="3" maxlength="120" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Program Officer</label>
                                <select name="programOfficerId" class="form-select" required>
                                    @foreach (var officer in Model.ProgramOfficers)
                                    {
                                        if (grant.ProgramOfficerId == officer.Id)
                                        {
                                            <option value="@officer.Id" selected>@officer.FirstName @officer.LastName (@officer.Email)</option>
                                        }
                                        else
                                        {
                                            <option value="@officer.Id">@officer.FirstName @officer.LastName (@officer.Email)</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Thematic Area</label>
                                <select name="thematicAreaId" class="form-select" required>
                                    @foreach (var area in Model.ThematicAreas)
                                    {
                                        if (grant.ThematicAreaId == area.Id)
                                        {
                                            <option value="@area.Id" selected>@area.Name (@area.Code)</option>
                                        }
                                        else
                                        {
                                            <option value="@area.Id">@area.Name (@area.Code)</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Budget</label>
                                <input type="number" min="0.01" step="0.01" name="budget" value="@grant.Budget.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Start Date</label>
                                <input type="date" name="startDate" value="@grant.StartDate.ToString("yyyy-MM-dd")" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">End Date</label>
                                <input type="date" name="endDate" value="@(grant.EndDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Description</label>
                                <textarea name="description" class="form-control" rows="3" maxlength="500">@grant.Description</textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteGrantModal-@grant.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="DeleteGrant" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Delete Grant</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="id" value="@grant.Id" />
                        <p class="mb-0">Delete <strong>@grant.Name</strong> permanently?</p>
                        <small class="text-muted">This works only if there are no linked applications or funds.</small>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
