@model ExuberantPathfinders.Web.Areas.Admin.ViewModels.ApplicantsListViewModel
@using ExuberantPathfinders.Web.Models

@{
    ViewData["Title"] = "Manage Applications";
}

<div class="container-fluid mt-4">
    @if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["AdminSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["AdminError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["AdminInfo"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["AdminInfo"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-1">Application Management</h1>
            <p class="text-muted mb-0">Review submissions and update statuses.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <form method="get" asp-action="Applications" class="row g-2 mb-3">
        <div class="col-md-6 col-lg-5">
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by reference, title, applicant, email, or program" />
        </div>
        <div class="col-md-3 col-lg-2">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                @foreach (var statusValue in Enum.GetValues<ApplicationStatus>())
                {
                    if (Model.Status == statusValue)
                    {
                        <option value="@statusValue" selected>@statusValue</option>
                    }
                    else
                    {
                        <option value="@statusValue">@statusValue</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2 col-lg-2">
            <select name="pageSize" class="form-select">
                @foreach (var size in new[] { 5, 10, 20, 50 })
                {
                    if (Model.PageSize == size)
                    {
                        <option value="@size" selected>@size / page</option>
                    }
                    else
                    {
                        <option value="@size">@size / page</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-1 col-lg-1 d-grid">
            <button type="submit" class="btn btn-primary">Go</button>
        </div>
        <div class="col-md-12 col-lg-2 d-grid">
            <a asp-action="Applications" class="btn btn-outline-light">Reset</a>
        </div>
    </form>

    @if (Model.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Reference</th>
                        <th>Applicant</th>
                        <th>Program</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th style="min-width: 340px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model.Items)
                    {
                        var statusClass = app.Status switch
                        {
                            ApplicationStatus.Draft => "secondary",
                            ApplicationStatus.Submitted => "info",
                            ApplicationStatus.UnderReview => "warning",
                            ApplicationStatus.Approved => "success",
                            ApplicationStatus.Rejected => "danger",
                            ApplicationStatus.OnHold => "dark",
                            _ => "light"
                        };

                        <tr>
                            <td><code>@(string.IsNullOrWhiteSpace(app.SubmissionReference) ? "-" : app.SubmissionReference)</code></td>
                            <td>
                                <strong>@app.Applicant?.FirstName @app.Applicant?.LastName</strong><br />
                                <small class="text-muted">@app.Applicant?.Email</small>
                            </td>
                            <td>@(app.Program?.Name ?? "N/A")</td>
                            <td>&#8358;@app.RequestedAmount.ToString("N2")</td>
                            <td><span class="badge bg-@statusClass">@app.Status</span></td>
                            <td>@(app.SubmittedAt?.ToString("dd MMM yyyy") ?? "Not Submitted")</td>
                            <td>
                                <div class="d-flex gap-1 mb-2">
                                    <form asp-action="UpdateApplicationStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@app.Id" />
                                        <input type="hidden" name="status" value="@ApplicationStatus.Approved" />
                                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                    </form>
                                    <form asp-action="UpdateApplicationStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@app.Id" />
                                        <input type="hidden" name="status" value="@ApplicationStatus.Rejected" />
                                        <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                                    </form>
                                    <form asp-action="UpdateApplicationStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@app.Id" />
                                        <input type="hidden" name="status" value="@ApplicationStatus.UnderReview" />
                                        <button type="submit" class="btn btn-sm btn-warning">Under Review</button>
                                    </form>
                                </div>
                                <form asp-action="UpdateApplicationStatus" method="post" class="row g-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@app.Id" />
                                    <div class="col-5">
                                        <select name="status" class="form-select form-select-sm">
                                            @foreach (var statusValue in Enum.GetValues<ApplicationStatus>())
                                            {
                                                if (app.Status == statusValue)
                                                {
                                                    <option value="@statusValue" selected>@statusValue</option>
                                                }
                                                else
                                                {
                                                    <option value="@statusValue">@statusValue</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-5">
                                        <input type="text" name="reason" class="form-control form-control-sm" placeholder="Optional note" maxlength="300" />
                                    </div>
                                    <div class="col-2 d-grid">
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Set</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <small class="text-muted">Showing page @Model.Page of @Model.TotalPages (@Model.TotalCount total records)</small>
            <nav aria-label="Application pagination">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Applications" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" asp-route-status="@Model.Status">Previous</a>
                    </li>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Applications" asp-route-page="@p" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" asp-route-status="@Model.Status">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Applications" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" asp-route-status="@Model.Status">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
    else
    {
        <div class="alert alert-info mb-0">
            No applications found for your current filter.
        </div>
    }
</div>
