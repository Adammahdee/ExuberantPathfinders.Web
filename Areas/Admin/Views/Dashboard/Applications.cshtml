@model List<ExuberantPathfinders.Web.Models.Application>

@{
    ViewData["Title"] = "Manage Applications";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3">Application Management</h1>
            <p class="text-muted">Review and manage all submitted applications.</p>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Reference</th>
                        <th>Applicant</th>
                        <th>Program</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model)
                    {
                        <tr>
                            <td>
                                <code>@app.SubmissionReference</code>
                            </td>
                            <td>
                                <strong>@app.Applicant?.FirstName @app.Applicant?.LastName</strong><br />
                                <small class="text-muted">@app.Applicant?.Email</small>
                            </td>
                            <td>@app.Program?.Name ?? "N/A"</td>
                            <td>₦@app.RequestedAmount.ToString("N2")</td>
                            <td>
                                @{
                                    var statusClass = app.Status switch
                                    {
                                        ExuberantPathfinders.Web.Models.ApplicationStatus.Draft => "secondary",
                                        ExuberantPathfinders.Web.Models.ApplicationStatus.Submitted => "info",
                                        ExuberantPathfinders.Web.Models.ApplicationStatus.UnderReview => "warning",
                                        ExuberantPathfinders.Web.Models.ApplicationStatus.Approved => "success",
                                        ExuberantPathfinders.Web.Models.ApplicationStatus.Rejected => "danger",
                                        ExuberantPathfinders.Web.Models.ApplicationStatus.OnHold => "warning",
                                        _ => "light"
                                    };
                                    var statusText = app.Status switch
                                    {
                                        ExuberantPathfinders.Web.Models.ApplicationStatus.Draft => "Draft",
                                        ExuberantPathfinders.Web.Models.ApplicationStatus.Submitted => "Submitted",
                                        ExuberantPathfinders.Web.Models.ApplicationStatus.UnderReview => "Under Review",
                                        ExuberantPathfinders.Web.Models.ApplicationStatus.Approved => "Approved",
                                        ExuberantPathfinders.Web.Models.ApplicationStatus.Rejected => "Rejected",
                                        ExuberantPathfinders.Web.Models.ApplicationStatus.OnHold => "On Hold",
                                        _ => "Unknown"
                                    };
                                }
                                <span class="badge bg-@statusClass">@statusText</span>
                            </td>
                            <td>@(app.SubmittedAt?.ToString("dd MMM yyyy") ?? "Not Submitted")</td>
                            <td>
                                <a href="#" class="btn btn-sm btn-outline-primary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No applications found.
        </div>
    }

    <div class="mt-3">
        <a href="@Url.Action("Index")" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>
