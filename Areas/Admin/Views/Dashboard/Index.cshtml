@model ExuberantPathfinders.Web.Areas.Admin.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid mt-2 admin-page">
    @if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["AdminSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["AdminError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="metric-card metric-teal">
                <p class="small mb-1">Total Applicants</p>
                <h3 class="mb-0">@Model.TotalApplications.ToString("N0")</h3>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="metric-card metric-purple">
                <p class="small mb-1">Grants Awarded</p>
                <h3 class="mb-0">&#8358;@Model.TotalDonations.ToString("N0")</h3>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="metric-card metric-orange">
                <p class="small mb-1">Pending Applications</p>
                <h3 class="mb-0">@Model.PendingApplications.ToString("N0")</h3>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="metric-card metric-blue">
                <p class="small mb-1">Active Campaigns</p>
                <h3 class="mb-0">@Model.ActiveCampaigns.ToString("N0")</h3>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0">
                    <h5 class="mb-0">Recent Applications</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Reference</th>
                                    <th>Applicant</th>
                                    <th>Status</th>
                                    <th>Program</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentApplications.Any())
                                {
                                    @foreach (var app in Model.RecentApplications)
                                    {
                                        <tr>
                                            <td><code>@(string.IsNullOrWhiteSpace(app.SubmissionReference) ? "-" : app.SubmissionReference)</code></td>
                                            <td>@app.Applicant?.FirstName @app.Applicant?.LastName</td>
                                            <td><span class="badge bg-secondary">@app.Status</span></td>
                                            <td>@(app.Program?.Name ?? "N/A")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">No recent applications.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white border-0">
                    <a asp-action="Applications" class="btn btn-outline-primary btn-sm">Open Applicants Module</a>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0">
                    <h5 class="mb-0">Modules</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Applications" class="btn btn-primary"><i class="fas fa-id-card me-1"></i> Applicants</a>
                        <a asp-action="Grants" class="btn btn-success"><i class="fas fa-award me-1"></i> Grants</a>
                        <a asp-action="Funds" class="btn btn-info text-white"><i class="fas fa-wallet me-1"></i> Funds</a>
                        <a asp-action="Reports" class="btn btn-warning"><i class="fas fa-chart-line me-1"></i> Reports</a>
                        <a asp-action="Users" class="btn btn-secondary"><i class="fas fa-users me-1"></i> Users</a>
                        <a asp-action="Logs" class="btn btn-dark"><i class="fas fa-list-check me-1"></i> Activity Log</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0">
            <h5 class="mb-0">Recent Activity Log</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Resource</th>
                            <th>Resource ID</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentAuditLogs.Any())
                        {
                            @foreach (var log in Model.RecentAuditLogs)
                            {
                                <tr>
                                    <td>@log.Id</td>
                                    <td>@(log.User?.Email ?? "System")</td>
                                    <td>@log.Action</td>
                                    <td>@log.EntityType</td>
                                    <td>@log.EntityId</td>
                                    <td>@log.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No audit entries yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-page .metric-card {
        border-radius: 14px;
        padding: 1rem;
        box-shadow: 0 10px 22px rgba(6, 8, 16, 0.25);
        border: 1px solid rgba(255,255,255,0.12);
    }

    .admin-page .metric-teal {
        background: linear-gradient(135deg, #29d7c6 0%, #3bcac5 100%);
        color: #072725;
    }

    .admin-page .metric-purple {
        background: linear-gradient(135deg, #8f69ff 0%, #b47cff 100%);
        color: #1f1237;
    }

    .admin-page .metric-orange {
        background: linear-gradient(135deg, #ffac53 0%, #ff9f4a 100%);
        color: #3a2103;
    }

    .admin-page .metric-blue {
        background: linear-gradient(135deg, #49a9ff 0%, #5dc0ff 100%);
        color: #07243f;
    }
</style>
