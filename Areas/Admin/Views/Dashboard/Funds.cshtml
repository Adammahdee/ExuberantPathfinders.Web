@model ExuberantPathfinders.Web.Areas.Admin.ViewModels.FundManagementViewModel

@{
    ViewData["Title"] = "Funds";
}

<div class="container-fluid mt-3">
    @if (!string.IsNullOrWhiteSpace(Model.FormSuccess))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.FormSuccess
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.FormError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.FormError
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-0">
            <h5 class="mb-0">Create Fund Campaign</h5>
        </div>
        <div class="card-body">
            <form asp-action="CreateFund" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <div class="col-md-4">
                    <label class="form-label">Campaign Name</label>
                    <input type="text" name="name" class="form-control" required minlength="3" maxlength="120" />
                    <small class="text-muted">3-120 characters.</small>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Program</label>
                    <select name="programId" class="form-select" required>
                        <option value="">Select program</option>
                        @foreach (var program in Model.Programs)
                        {
                            <option value="@program.Id">@program.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Target Amount</label>
                    <input type="number" min="0.01" step="0.01" name="targetAmount" class="form-control" required />
                    <small class="text-muted">0.01 to 100,000,000,000.</small>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Start Date</label>
                    <input type="date" name="startDate" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">End Date</label>
                    <input type="date" name="endDate" class="form-control" required />
                    <small class="text-muted">Must be on/after start date.</small>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Description</label>
                    <input type="text" name="description" class="form-control" maxlength="500" />
                    <small class="text-muted">Max 500 characters.</small>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-info text-white">Create Campaign</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0">
            <h5 class="mb-0">Campaign Funds</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Campaign</th>
                            <th>Program</th>
                            <th>Target</th>
                            <th>Raised</th>
                            <th>Donations</th>
                            <th>Status</th>
                            <th style="min-width: 280px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var campaign in Model.Campaigns)
                        {
                            <tr>
                                <td>@campaign.Name</td>
                                <td>@(campaign.Program?.Name ?? "N/A")</td>
                                <td>&#8358;@campaign.TargetAmount.ToString("N2")</td>
                                <td>&#8358;@campaign.AmountRaised.ToString("N2")</td>
                                <td>@campaign.Donations.Count</td>
                                <td>
                                    <span class="badge @(campaign.IsActive ? "bg-success" : "bg-danger")">@(campaign.IsActive ? "Active" : "Inactive")</span>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        <form asp-action="ToggleFundStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@campaign.Id" />
                                            <button type="submit" class="btn btn-sm @(campaign.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                                @(campaign.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editFundModal-@campaign.Id">
                                            Edit
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteFundModal-@campaign.Id">
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@foreach (var campaign in Model.Campaigns)
{
    <div class="modal fade" id="editFundModal-@campaign.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form asp-action="EditFund" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Campaign: @campaign.Name</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="id" value="@campaign.Id" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Campaign Name</label>
                                <input type="text" name="name" value="@campaign.Name" class="form-control" required minlength="3" maxlength="120" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Program</label>
                                <select name="programId" class="form-select" required>
                                    @foreach (var program in Model.Programs)
                                    {
                                        if (campaign.ProgramId == program.Id)
                                        {
                                            <option value="@program.Id" selected>@program.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@program.Id">@program.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Target Amount</label>
                                <input type="number" min="0.01" step="0.01" name="targetAmount" value="@campaign.TargetAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Start Date</label>
                                <input type="date" name="startDate" value="@campaign.StartDate.ToString("yyyy-MM-dd")" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">End Date</label>
                                <input type="date" name="endDate" value="@campaign.EndDate.ToString("yyyy-MM-dd")" class="form-control" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Description</label>
                                <textarea name="description" class="form-control" rows="3" maxlength="500">@campaign.Description</textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteFundModal-@campaign.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="DeleteFund" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Delete Campaign</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="id" value="@campaign.Id" />
                        <p class="mb-0">Delete <strong>@campaign.Name</strong> permanently?</p>
                        <small class="text-muted">This works only if there are no donation records.</small>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
