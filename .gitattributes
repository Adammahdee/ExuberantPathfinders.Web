# Auto normalize line endings
* text=auto

# Explicitly set line endings for files
*.cs text eol=crlf
*.cshtml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.json text eol=crlf
*.xml text eol=crlf
*.config text eol=crlf

# Binary files
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.gif binary
